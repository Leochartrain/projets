---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CarteRecette from '../components/CarteRecette.astro';
import { SITE } from '../config';
import { categorie, categoriesUtilisees, getRecettes } from '../lib/recettes';

const recettes = await getRecettes();
const [une] = recettes;
// La recette à la une n'est pas répétée dans la grille.
const dernieres = recettes.slice(1, 7);
const categories = categoriesUtilisees(recettes);
---
<Base>
  {une && (
    <section class="une container">
      <a class="une-photo" href={`/recettes/${une.id}`} tabindex="-1" aria-hidden="true">
        <Image src={une.data.photo} alt="" widths={[600, 900, 1300]} sizes="(max-width: 50rem) 100vw, 40rem" loading="eager" fetchpriority="high" />
      </a>
      <div class="une-texte">
        <p class="surtitre">Dernière recette · {categorie(une.data.categorie).name}</p>
        <h1>{une.data.titre}</h1>
        <p class="une-resume">{une.data.resume}</p>
        <a class="bouton" href={`/recettes/${une.id}`}>Voir la recette</a>
      </div>
    </section>
  )}

  <section class="intro container">
    <hr class="filet" />
    <p>
      Les recettes de pâtisserie que j'utilise : les miennes, et celles d'autres pâtissiers que je refais
      chez moi, toujours créditées. Les quantités se recalculent selon le nombre de parts.
    </p>
  </section>

  {categories.length > 0 && (
    <section class="carte-categories container" aria-labelledby="titre-carte">
      <h2 id="titre-carte" class="caps">La carte</h2>
      <ul>
        {categories.map((c) => (
          <li>
            <a href={`/categorie/${c.slug}`}>
              <span class="nom">{c.name}</span>
              <span class="small">{c.count} recette{c.count > 1 ? 's' : ''}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {dernieres.length > 0 && (
  <section class="container" aria-labelledby="titre-dernieres">
    <div class="entete-section">
      <h2 id="titre-dernieres">Les dernières recettes</h2>
      <a class="caps" href="/recettes">Toutes les recettes →</a>
    </div>
    <div class="grille">
      {dernieres.map((r) => <CarteRecette recette={r} />)}
    </div>
  </section>
  )}

  <section class="apropos container">
    <p class="surtitre">{SITE.author}</p>
    <h2>Pâtissier amateur</h2>
    <p>Ma famille et mes amis me demandent souvent mes recettes : les voici, rangées au même endroit et ouvertes à tous.</p>
    <a class="bouton" href="/a-propos">En savoir plus</a>
  </section>
</Base>

<style>
  .une {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .une-photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--accent-clair);
  }

  .une-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .une-texte h1 {
    margin: 1rem 0 1.25rem;
  }

  .une-resume {
    color: var(--gris);
    max-width: 30rem;
    margin: 0 0 2rem;
  }

  .intro {
    max-width: 42rem;
    text-align: center;
    padding-top: 3rem;
    padding-bottom: 2rem;
    font-family: var(--serif);
    font-size: 1.45rem;
    line-height: 1.5;
  }

  .carte-categories {
    text-align: center;
    padding-bottom: 4rem;
  }

  .carte-categories h2 {
    color: var(--gris);
    margin-bottom: 1.5rem;
  }

  .carte-categories ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .carte-categories a {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 10rem;
    padding: 1rem 1.5rem;
    border: 1px solid var(--filet);
    background: var(--blanc);
    text-decoration: none;
  }

  .carte-categories a:hover {
    border-color: var(--accent);
  }

  .carte-categories .nom {
    font-family: var(--serif);
    font-size: 1.5rem;
  }

  .entete-section {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--filet);
  }

  .entete-section a {
    text-decoration: none;
  }

  .apropos {
    max-width: 40rem;
    text-align: center;
    margin-top: 6rem;
  }

  .apropos h2 {
    margin: 0.75rem 0 1rem;
  }

  .apropos p:not(.surtitre) {
    color: var(--gris);
    margin: 0 0 2rem;
  }

  @media (max-width: 50rem) {
    .une {
      grid-template-columns: 1fr;
      text-align: center;
      padding-left: 0;
      padding-right: 0;
    }

    .une-texte {
      padding: 0 var(--marge);
    }

    .une-resume {
      margin-left: auto;
      margin-right: auto;
    }

    .une-photo {
      aspect-ratio: 1 / 1;
    }
  }
</style>
