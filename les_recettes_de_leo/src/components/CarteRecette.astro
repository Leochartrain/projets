---
import { Image } from 'astro:assets';
import { categorie, duree, tempsTotal, type Recette } from '../lib/recettes';

interface Props {
  recette: Recette;
  /** La première carte visible se charge tout de suite, les autres au défilement. */
  prioritaire?: boolean;
}
const { recette, prioritaire = false } = Astro.props;
const d = recette.data;
---
<a class="carte" href={`/recettes/${recette.id}`}>
  <div class="carte-photo">
    <Image
      src={d.photo}
      alt={d.photoAlt}
      widths={[400, 700, 1000]}
      sizes="(max-width: 40rem) 100vw, 24rem"
      loading={prioritaire ? 'eager' : 'lazy'}
    />
  </div>
  <p class="surtitre">{categorie(d.categorie).name}</p>
  <h3>{d.titre}</h3>
  <p class="small">{duree(tempsTotal(recette))} · {d.difficulte}</p>
</a>

<style>
  .carte {
    display: block;
    text-decoration: none;
    text-align: center;
  }

  .carte-photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--accent-clair);
    margin-bottom: 1.1rem;
  }

  .carte-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .carte:hover .carte-photo :global(img) {
    transform: scale(1.03);
  }

  .carte:hover {
    color: inherit;
  }

  .carte:hover h3 {
    color: var(--accent);
  }

  h3 {
    margin: 0.4rem 0 0.3rem;
    transition: color 0.2s;
  }

  .small {
    margin: 0;
  }
</style>
