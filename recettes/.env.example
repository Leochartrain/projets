# Copier en .env.local et remplir avec les valeurs du projet Supabase
# (Project Settings → API). La clé « anon / publishable » peut être publique :
# ce sont les règles d'accès de la base qui protègent les données.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# 1 pour afficher « Continuer avec Google » (à configurer dans Supabase → Authentication → Providers).
VITE_AUTH_GOOGLE=0
