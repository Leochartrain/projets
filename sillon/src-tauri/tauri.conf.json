{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sillon",
  "version": "0.1.0",
  "identifier": "fr.leochartrain.sillon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5260",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sillon",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Léo Chartrain",
    "category": "Music",
    "shortDescription": "Lecteur de musique local",
    "longDescription": "Sillon, lecteur de musique local pour une bibliothèque FLAC, sans compte ni abonnement.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
